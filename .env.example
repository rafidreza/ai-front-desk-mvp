PORT=4000
NODE_ENV=development
WEB_APP_URL=http://localhost:3002
API_BASE_URL=http://localhost:4000
INTERNAL_API_TOKEN=change-this-long-random-api-token
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full

MESSENGER_VERIFY_TOKEN=replace-with-meta-webhook-token
ENABLE_MESSENGER=false
MESSENGER_GRAPH_VERSION=v20.0
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ACCESS_TOKEN=
META_APP_ID=2238102173658208
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://dev.daemion.io/api/meta/callback
META_OAUTH_SCOPES=pages_show_list,pages_manage_metadata,pages_messaging

ENABLE_P1_WHATSAPP_PINGS=true
ENABLE_WHATSAPP=false
WHATSAPP_VERIFY_TOKEN=replace-with-meta-whatsapp-webhook-token
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

EMAIL_FROM_ADDRESS=Daemion <support@daemion.io>
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

GOOGLE_CLOUD_VISION_API_KEY=

# Optional: voice note transcription through OpenAI's audio transcription API.
OPENAI_API_KEY=
ASR_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
ASR_TRANSCRIPTION_PROMPT=Bangla, Banglish, and English ecommerce customer support.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

INTERNAL_CONSOLE_PASSWORD=change-this-before-sharing
INTERNAL_CONSOLE_SESSION_SECRET=change-this-long-random-secret
CLIENT_AUTH_CODE_SECRET=change-this-long-random-client-auth-secret
DEV_RETURN_AUTH_CODE=false
DEV_CLIENT_AUTH_CODE=
CLIENT_SESSION_SECRET=change-this-long-random-client-session-secret

# Optional: shared production rate limits across Workers / server instances.
# Leave empty for local in-memory rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: backend error reporting. Leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
APP_VERSION=
