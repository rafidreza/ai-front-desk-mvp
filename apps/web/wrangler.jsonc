{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-front-desk-web",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "env": {
    "staging": {
      "name": "ai-front-desk-web-staging",
      "workers_dev": true,
      "images": {
        "binding": "IMAGES"
      },
      "vars": {
        "NODE_ENV": "production"
      }
    }
  }
}
