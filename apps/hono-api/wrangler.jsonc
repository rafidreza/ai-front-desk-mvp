{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-front-desk-hono-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PORT": "8787",
    "NODE_ENV": "development",
    "MESSENGER_GRAPH_VERSION": "v20.0",
    "MESSENGER_VERIFY_TOKEN": "daemion_dev_verify_token",
    "WHATSAPP_GRAPH_VERSION": "v20.0",
    "WHATSAPP_VERIFY_TOKEN": "daemion_dev_verify_token",
    "ENABLE_MESSENGER": "false",
    "ENABLE_WHATSAPP": "false",
    "ENABLE_P1_WHATSAPP_PINGS": "true",
    "POSTMARK_MESSAGE_STREAM": "outbound",
    "ANTHROPIC_MODEL": "claude-3-5-haiku-latest",
    "ENABLE_DEV_INTERNAL_USERS": "true",
    "DEV_RETURN_AUTH_CODE": "false"
  },
  "env": {
    "staging": {
      "name": "ai-front-desk-hono-api-staging",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "api.dev.daemion.io",
          "custom_domain": true
        }
      ],
      "vars": {
        "PORT": "8787",
        "NODE_ENV": "production",
        "MESSENGER_GRAPH_VERSION": "v20.0",
        "MESSENGER_VERIFY_TOKEN": "daemion_dev_verify_token",
        "WHATSAPP_GRAPH_VERSION": "v20.0",
        "WHATSAPP_VERIFY_TOKEN": "daemion_dev_verify_token",
        "ENABLE_MESSENGER": "false",
        "ENABLE_WHATSAPP": "false",
        "ENABLE_P1_WHATSAPP_PINGS": "true",
        "POSTMARK_MESSAGE_STREAM": "outbound",
        "ANTHROPIC_MODEL": "claude-3-5-haiku-latest",
        "ENABLE_DEV_INTERNAL_USERS": "true",
        "DEV_RETURN_AUTH_CODE": "false"
      }
    }
  }
}
