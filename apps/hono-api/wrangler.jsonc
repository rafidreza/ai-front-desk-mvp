{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-front-desk-hono-api",
  "account_id": "637d1f18381f36341614d22b989d6d25",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PORT": "8787",
    "NODE_ENV": "development",
    "MESSENGER_GRAPH_VERSION": "v20.0",
    "META_APP_ID": "2238102173658208",
    "META_OAUTH_REDIRECT_URI": "https://dev.daemion.io/api/meta/callback",
    "META_OAUTH_SCOPES": "pages_show_list,pages_manage_metadata,pages_messaging",
    "WHATSAPP_GRAPH_VERSION": "v20.0",
    "ENABLE_MESSENGER": "false",
    "ENABLE_WHATSAPP": "false",
    "ENABLE_P1_WHATSAPP_PINGS": "true",
    "POSTMARK_MESSAGE_STREAM": "outbound",
    "ANTHROPIC_MODEL": "claude-3-5-haiku-latest",
    "ENABLE_DEV_INTERNAL_USERS": "true",
    "DEV_RETURN_AUTH_CODE": "false"
  },
  "env": {
    "staging": {
      "name": "ai-front-desk-hono-api-staging",
      "account_id": "637d1f18381f36341614d22b989d6d25",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "api.dev.daemion.io",
          "custom_domain": true
        }
      ],
      "vars": {
        "PORT": "8787",
        "NODE_ENV": "production",
        "MESSENGER_GRAPH_VERSION": "v20.0",
        "META_APP_ID": "2238102173658208",
        "META_OAUTH_REDIRECT_URI": "https://dev.daemion.io/api/meta/callback",
        "META_OAUTH_SCOPES": "pages_show_list,pages_manage_metadata,pages_messaging",
        "WHATSAPP_GRAPH_VERSION": "v20.0",
        "ENABLE_MESSENGER": "false",
        "ENABLE_WHATSAPP": "false",
        "ENABLE_P1_WHATSAPP_PINGS": "true",
        "POSTMARK_MESSAGE_STREAM": "outbound",
        "ANTHROPIC_MODEL": "claude-3-5-haiku-latest",
        "ENABLE_DEV_INTERNAL_USERS": "true",
        "DAEMION_ENV": "preview",
        "DEV_RETURN_AUTH_CODE": "true"
      }
    }
  }
}
