# Copy to .env and fill in. Never commit .env.

# Brain (LLM) via OpenRouter — reuses the backend's OpenRouter account (OpenAI-compatible).
# Grab the real key from Cloudflare Worker secrets (it's scrubbed from ai-front-desk-mvp/.env).
OPENROUTER_API_KEY=xxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Use a FAST model for voice (low time-to-first-token). Big models feel laggy on a live call.
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Speech-to-text: Deepgram streaming — what the live pipeline actually uses.
DEEPGRAM_API_KEY=xxxxxxxx

# Text-to-speech: ElevenLabs. Give the key TTS + Voices(Read) access.
ELEVENLABS_API_KEY=xxxxxxxx
# Pick a multilingual voice in the ElevenLabs UI and paste its Voice ID.
ELEVENLABS_VOICE_ID=xxxxxxxx
# Speech-to-text model + language. Defaults (nova-3 + bn) are set in pipeline.py and are what the
# product needs — 'bn' is the only setting that handles Bangla, Banglish AND English. Do NOT use
# 'multi': nova-3 has no Bengali in its code-switching set and transcribes Bangla into Hindi.
# Only set these to override, e.g. STT_LANGUAGE=en for an English-only client.
# STT_MODEL=nova-3
# STT_LANGUAGE=bn

# Backend bridge (optional). When set, the agent grounds on the client's REAL KB/context from the
# TS backend instead of the local hardcoded persona. Leave BACKEND_URL blank to run standalone.
BACKEND_URL=
INTERNAL_API_TOKEN=
# Which client (tenant) this agent serves. Used ONLY by web.py, the local dev runner.
# widget_server.py ignores it — there the tenant comes from the signed session token.
CLIENT_ID=

# --- Web-widget voice calling (widget_server.py) ----------------------------------------------
# MUST match WIDGET_VOICE_TOKEN_SECRET in the Hono API. The API signs session tokens with it and
# this runtime verifies them; a mismatch rejects every call with 401. Min 32 chars in production.
WIDGET_VOICE_TOKEN_SECRET=dev-widget-voice-token-secret-only-for-local-work

VOICE_RUNTIME_HOST=0.0.0.0
VOICE_RUNTIME_PORT=7860
# Browser origins allowed to post a WebRTC offer here (comma-separated).
WEB_APP_URL=http://localhost:3002
# Ceiling on simultaneous calls. Each holds an STT socket, an LLM stream and a TTS socket.
VOICE_MAX_CONCURRENT_CALLS=10

# --- WebRTC connectivity ----------------------------------------------------------------------
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
# TURN is REQUIRED in production. Without it, visitors behind symmetric NAT or a corporate
# firewall (~15-20%) never connect, and it presents as "the call button doesn't work" with no
# error visible anywhere. See infra/coturn/turnserver.conf.example.
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=

# --- PARKED: telephony ------------------------------------------------------------------------
# No phone/SIP provider is wired — bot.py and server.py are commented out. Nothing below is
# needed for web-widget calling. Restore when a carrier is signed.
# PORT=8080
